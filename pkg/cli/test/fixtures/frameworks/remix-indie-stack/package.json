{
  "name": "remix-indie-stack",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "remix build",
    "dev": "remix dev -c \"npm run dev:serve\"",
    "dev:serve": "binode --require mocks -- @remix-run/serve:remix-serve ./build/index.js",
    "format": "prettier --write ",
    "format:repo": "npm run format && npm run lint -- --fix",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint ",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "remix-serve ./build/index.js",
    "start:mocks": "binode --require mocks -- @remix-run/serve:remix-serve ./build/index.js",
    "test": "vitest",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "tsc && tsc -p cypress",
    "validate": "npm-run-all --parallel \"test -- --run\" lint typecheck test:e2e:run"
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@prisma/client": "catalog:",
    "@remix-run/css-bundle": "catalog:",
    "@remix-run/node": "catalog:",
    "@remix-run/react": "catalog:",
    "@remix-run/serve": "catalog:",
    "bcryptjs": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tiny-invariant": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@remix-run/dev": "catalog:",
    "@testing-library/cypress": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/bcryptjs": "catalog:",
    "@types/cookie": "catalog:",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "catalog:",
    "binode": "catalog:",
    "cookie": "catalog:",
    "cross-env": "catalog:",
    "cypress": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-cypress": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-jest-dom": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-markdown": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "happy-dom": "catalog:",
    "msw": "catalog:",
    "npm-run-all2": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "prisma": "catalog:",
    "start-server-and-test": "catalog:",
    "tailwindcss": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
