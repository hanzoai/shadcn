    "recharts": "catalog:",
    "tailwindcss-animate": "catalog:",
    "tsx": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
