  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "cli:build": "pnpm --filter shadcn build",
    "cli:dev": "pnpm --filter shadcn start:dev",
    "cli:test": "pnpm --filter tests test",
    "components:build": "pnpm --filter @hanzo/shadcn build",
    "registry:build": "pnpm --filter @hanzo/ui-web registry:build",
    "registry:capture": "pnpm --filter @hanzo/ui-web registry:capture",
    "validate:registries": "pnpm --filter v4 validate:registries",
    "app:dev": "pnpm --filter @hanzo/ui-web dev",
    "app:build": "pnpm --filter @hanzo/ui-web build",
    "v4:dev": "pnpm --filter v4 dev",
    "v4:build": "pnpm --filter v4 build",
    "examples:build": "pnpm --filter v4 examples:build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "sync:templates": "./scripts/sync-templates.sh \"templates/*\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual/"
  },
  "packageManager": "pnpm@9.0.6",
  "dependencies": {
